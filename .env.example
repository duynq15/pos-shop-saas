# Cổng và địa chỉ lắng nghe
PORT=3000
HOST=0.0.0.0

# Nơi lưu dữ liệu (control.db + tenants/<mã>/pos.db)
DATA_DIR=/data

# Basic Auth cấp cho VietQR gọi webhook (tự đặt, gửi cho VietQR)
VQR_EXPOSED_USER=posshop
VQR_EXPOSED_PASS=doi-mat-khau-nay

# Chuỗi bí mật ký token callback (đổi trước khi GoLive)
VQR_SECRET=doi-chuoi-bi-mat-nay

# Tài khoản tạo sẵn lần đầu (nên đổi)
ROOT_PASS=root123
ADMIN_PASS=admin123
SHOP_NAME=Cửa hàng mặc định

# API tài khoản Sáng Kiến Hưng Gia (Làng Số gọi /api/lang-so/* và đăng nhập một lần bằng token này)
SKHG_API_BASE=https://app.sangkienhunggia.vn/api/v1
# Danh sách hộ từ trang Hành chính (repo thon-thong-minh). Trống = tắt tính năng theo hộ.
# LANGSO_KHOA_TICH_HOP phải trùng LS_KHOA_TICH_HOP_SO_QUY bên Hành chính.
LANGSO_HANHCHINH_API=
LANGSO_KHOA_TICH_HOP=

# Múi giờ (ngày "hôm nay", kiểm tra đêm 02:00)
TZ=Asia/Ho_Chi_Minh
